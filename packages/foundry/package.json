{
  "name": "@prisoners-daollema/foundry",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account": "make account",
    "account:generate": "node scripts-js/generateKeystore.js",
    "account:import": "node scripts-js/importAccount.js",
    "account:reveal-pk": "node scripts-js/revealPK.js",
    "auth": "node scripts-js/authCli.js",
    "auth:flow": "node scripts-js/authFlowCli.js",
    "auth:smoke": "node scripts-js/authFlowCli.js",
    "auth:permit": "node scripts-js/authCli.js permit",
    "auth:register": "node scripts-js/authCli.js register",
    "auth:status": "node scripts-js/authCli.js status",
    "query": "node scripts-js/queryCli.js",
    "query:auth": "node scripts-js/queryCli.js auth",
    "query:export": "node scripts-js/queryCli.js export",
    "query:messages": "node scripts-js/queryCli.js messages",
    "query:summary": "node scripts-js/queryCli.js summary",
    "smoke:integration": "forge build && node --test scripts-js/integrationSmoke.test.js",
    "siwa-nonce": "node scripts-js/authCli.js siwa-nonce",
    "siwa-sign": "node scripts-js/authCli.js siwa-sign",
    "siwa-verify": "node scripts-js/authCli.js siwa-verify",
    "chain": "make chain",
    "clean": "forge clean",
    "compile": "make compile",
    "deploy": "node scripts-js/parseArgs.js",
    "flatten": "make flatten",
    "fork": "make fork FORK_URL=${1:-base}",
    "format": "make format",
    "postinstall": "shx cp -n .env.example .env",
    "lint": "make lint",
    "test": "forge test && node --test scripts-js/*.test.js",
    "test:js": "node --test scripts-js/*.test.js",
    "verify": "make verify RPC_URL=${1:-localhost}"
  },
  "dependencies": {
    "@buildersgarden/siwa": "0.0.24",
    "dotenv": "~16.3.1",
    "envfile": "~6.18.0",
    "ethers": "~5.7.1",
    "prettier": "~2.8.8",
    "qrcode": "~1.5.3",
    "toml": "~3.0.0",
    "viem": "2.39.0"
  },
  "devDependencies": {
    "shx": "^0.3.4"
  }
}
