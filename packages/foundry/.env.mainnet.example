# Base mainnet launch template
# Copy values deliberately; do not rely on Sepolia/dev defaults for mainnet.

# Explorer / verification
BASESCAN_API_KEY=

# Role addresses (REQUIRED for strict/mainnet deploy)
PRISONERS_OWNER=
PRISONERS_TREASURY=
# Must be an EOA address with an available signing key.
# Contract verifiers (e.g. Safe / EIP-1271) are not supported by the current AgentAuthRegistry flow.
PRISONERS_AUTH_VERIFIER=
PRISONERS_AUTH_VERIFIER_CONFIRM_EOA_SIGNER=true

# Example conservative first-mainnet canary profile.
# Final first-game values should still be chosen deliberately at launch time.
PRISONERS_ENTRY_FEE_WEI=1000000000000000
PRISONERS_CREATOR_FEE_BPS=100
PRISONERS_CAUSE_FEE_BPS=100
PRISONERS_JOIN_DURATION_SECONDS=300
PRISONERS_COMMIT_DURATION_BLOCKS=60
PRISONERS_REVEAL_DURATION_BLOCKS=60
PRISONERS_MIN_PLAYERS=3
PRISONERS_MAX_PLAYERS=5
PRISONERS_MAX_CAUSES=3

# Preflight validates deploy-time config only.
# At least one cause must still be whitelisted onchain before createGame().

# Optional safety hardening. The deploy script also forces strict mode on Base mainnet.
PRISONERS_STRICT_DEPLOY=true
