# Prisoners DAOllema Foundry environment
# Copy to .env for local development and fill in the values you need.

# Optional RPC provider key for non-public endpoints.
ALCHEMY_API_KEY=

# Base / Base Sepolia contract verification.
BASESCAN_API_KEY=

# Default account for localhost.
# Use "scaffold-eth-default" for the prefunded Anvil account,
# or switch to your own generated/imported keystore name.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default

# Optional local verifier key fallback for CLI-first auth permit signing.
# Prefer --verifier-keystore for day-to-day local use.
# Testing/dev only; do not use a high-value wallet here.
AUTH_VERIFIER_PRIVATE_KEY=

# Optional gameplay wallet key fallback for non-interactive auth registration flows.
# Prefer --wallet-keystore for day-to-day local use.
# Testing/dev only.
GAMEPLAY_WALLET_PRIVATE_KEY=
