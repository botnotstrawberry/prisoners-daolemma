# Prisoners DAOlemma Foundry environment
# Copy to .env for local development and fill in the values you need.

# Optional RPC provider key for non-public endpoints.
ALCHEMY_API_KEY=

# Base / Base Sepolia contract verification.
BASESCAN_API_KEY=

# Default account for localhost.
# Use "scaffold-eth-default" for the prefunded Anvil account,
# or switch to your own generated/imported keystore name.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default

# Optional gameplay wallet key fallback for non-interactive ERC-8004 self-registration flows.
# Prefer --wallet-keystore for day-to-day local use.
# Testing/dev only.
GAMEPLAY_WALLET_PRIVATE_KEY=

# --- Base Sepolia deployment / canary defaults ---
# Leave blank to accept the deploy script fallback behavior.
# For canary work, set these explicitly so the operator intent is captured in-repo.
PRISONERS_OWNER=
PRISONERS_TREASURY=
ERC8004_IDENTITY_REGISTRY=

# The deployment script already defaults to the Base Sepolia tiny-canary profile below.
# Keeping the values here makes that profile explicit and lets canary:preflight compare
# the intended config against PARAMETERS.md before you deploy.
#
# Important: these timings are for the first small honest canary only.
# Do not reuse 20/20 for a 32-player rehearsal or for anything mainnet-bound.
# See PARAMETERS.md for the slower 32-player Sepolia rehearsal profile and the
# much wider 256-player public-scale target profile.
PRISONERS_ENTRY_FEE_WEI=1000000000000000
PRISONERS_CREATOR_FEE_BPS=100
PRISONERS_CAUSE_FEE_BPS=100
PRISONERS_JOIN_DURATION_SECONDS=900
PRISONERS_COMMIT_DURATION_BLOCKS=20
PRISONERS_REVEAL_DURATION_BLOCKS=20
PRISONERS_MIN_PLAYERS=3
PRISONERS_MAX_PLAYERS=32
PRISONERS_MAX_CAUSES=8
